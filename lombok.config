# This is the root lombok.config for the project.
# stopBubbling = true tells Lombok not to search parent directories for more config.
config.stopBubbling = true

# Marks Lombok-generated methods with @lombok.Generated so code-coverage
# tools (e.g., JaCoCo) exclude them from coverage reports.
lombok.addLombokGeneratedAnnotation = true

# Warns (rather than silently ignoring) when @EqualsAndHashCode is used on a
# subclass without an explicit decision on whether to include superclass fields.
lombok.equalsAndHashCode.callSuper = warn

# Warns if @ToString is used on a subclass without an explicit callSuper decision.
lombok.toString.callSuper = warn

# Disallows the @Builder.Default trap where a default value is silently ignored
# if not explicitly annotated.
lombok.builder.className = Builder
